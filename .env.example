NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
JWT_ISSUER=ledgerguard
JWT_AUDIENCE=ledgerguard-api
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
REDIS_URL=redis://localhost:6379
# Map verified organization IDs to trusted tenant-specific MongoDB URIs.
# Never accept a database URI from a client request or JWT claim.
TENANT_DATABASE_URIS={"org_demo":"mongodb://localhost:27017/ledgerguard_org_demo?replicaSet=rs0"}
